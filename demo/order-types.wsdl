<?xml version="1.0" encoding="UTF-8"?>
<!-- Imported by order-service.wsdl through <wsdl:import location="...">,
     which is how a WSDL splits across files. -->
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="urn:acme:orders:types">

    <wsdl:types>
        <xs:schema targetNamespace="urn:acme:orders:types">
            <!-- The schema inside a WSDL still uses schemaLocation. -->
            <xs:include schemaLocation="common-types.xsd"/>

            <xs:complexType name="OrderSummaryType">
                <xs:sequence>
                    <xs:element name="orderId" type="xs:string"/>
                    <xs:element name="total" type="xs:decimal"/>
                </xs:sequence>
            </xs:complexType>
        </xs:schema>
    </wsdl:types>

    <wsdl:message name="GetOrderIn">
        <wsdl:part name="orderId" type="xs:string"/>
    </wsdl:message>

</wsdl:definitions>
